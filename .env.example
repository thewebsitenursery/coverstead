# Configure before running npm start. Never commit actual credentials.
PUBLIC_URL=http://127.0.0.1:3100
PORT=3100
HOST=127.0.0.1
# true behind HTTPS; false only for a local HTTP preview.
COOKIE_SECURE=false
DB_PATH=data/coverstead.sqlite
ASSET_PATH=data/assets
EDITION=community
DEMO_MODE=false
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only until the initial owner account has been created.
SETUP_TOKEN=
# SMTP is disabled until explicitly configured and verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DNS_READY=false
ONLINE_DEPOSITS_ENABLED=false
# Optional aggregate public resource counts. No cookies or visitor identifiers.
# Stored beside DB_PATH; disabled on venue installations by default.
WEBSITE_METRICS_ENABLED=false
# Product-site enquiries stay closed until contact and handling arrangements are verified.
ENQUIRIES_ENABLED=false
ENQUIRY_CONTACT_EMAIL=
ENQUIRY_NOTICE_CONFIRMED=false
# Product-site alerts through the host's /usr/sbin/sendmail; disabled by default.
# Sends only to ENQUIRY_CONTACT_EMAIL, with the visitor as Reply-To.
ENQUIRY_EMAIL_ENABLED=false
# Optional product-site subscription pilot. Only test keys are accepted.
# Separate from restaurant guest deposits. Keep actual keys in private config.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PORTAL_CONFIGURATION=
